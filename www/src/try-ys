    ys -e 'each [i (1 .. 5)]:' -e '  say: "Hello!"' --compile
    ys -e 'each [i (1 .. 5)]:' -e '  say: "Hello!"' --load

    curl https://yamlscript.org/try/99-bottles.ys | ys - 3
