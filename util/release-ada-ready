#!/usr/bin/env bash

set -euo pipefail

user=${1:?Usage: release-ada-ready GITHUB-USER VERSION}
version=${2:?Usage: release-ada-ready GITHUB-USER VERSION}

repo=alire-project/alire-index
branch=release/yamlscript-$version

die() {
  echo "ERROR: $*" >&2
  exit 1
}

echo "Locating Alire index PR for yamlscript $version..."
for attempt in 1 2 3 4 5; do
  pr=$(gh pr list \
    --repo "$repo" \
    --state open \
    --author "$user" \
    --head "$branch" \
    --json number,isDraft \
    --jq 'if length == 1 then "\(.[0].number) \(.[0].isDraft)" else empty end')
  [[ $pr ]] && break
  [[ $attempt == 5 ]] || sleep 2
done
[[ $pr ]] || die "Alire index PR not found for branch $branch"

read -r number draft <<< "$pr"
if [[ $draft == true ]]; then
  gh pr ready "$number" --repo "$repo"
else
  echo "Alire index PR #$number is already ready for review"
fi
