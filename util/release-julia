#!/usr/bin/env bash

set -euo pipefail

root=${YAMLSCRIPT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
commit=$(git -C "$root" rev-parse HEAD)
api_url=${YS_GH_API_URL:-https://api.github.com/repos/yaml/yamlscript}

if [[ ${YS_RELEASE_DRYRUN:-} == 1 ]]; then
  echo "Would request Julia registration for commit $commit"
  exit 0
fi

token=${YS_GH_TOKEN:-${JULIA_GITHUB_TOKEN:-${GH_TOKEN:-${GITHUB_TOKEN:-}}}}
secrets_file=${YS_SECRETS_FILE:-$HOME/.yamlscript-secrets.yaml}
if [[ -z $token && -r $secrets_file ]]; then
  token=$(
    YS_SECRETS_FILE=$secrets_file "${YS:-ys}" -e \
      'say: yaml/load(read(ENV.YS_SECRETS_FILE)).github.token || ""'
  )
fi

[[ $token ]] || {
  echo 'Error: set YS_GH_TOKEN, JULIA_GITHUB_TOKEN, GH_TOKEN,' >&2
  echo "GITHUB_TOKEN, or .github.token in $secrets_file" >&2
  exit 1
}

echo "Requesting Julia registration for commit $commit"
curl --fail-with-body -sS -L -X POST \
  -H 'Accept: application/vnd.github+json' \
  -H "Authorization: Bearer $token" \
  -H 'X-GitHub-Api-Version: 2022-11-28' \
  "$api_url/commits/$commit/comments" \
  -d '{"body":"@JuliaRegistrator register subdir=julia\n"}'
