#!/usr/bin/env bash

lang=d

source "${YAMLSCRIPT_ROOT?}/util/release-repo.bash"

dub_secret() {
  local secret=${DUB_UPDATE_SECRET:-}
  local secrets_file=${YS_SECRETS_FILE:-$HOME/.yamlscript-secrets.yaml}
  if [[ -z $secret && -r $secrets_file ]]; then
    secret=$(
      YS_SECRETS_FILE=$secrets_file "${YS:-ys}" -e \
        'say: yaml/load(read(ENV.YS_SECRETS_FILE)).dlang.token.yamlscript || ""' \
        2>/dev/null || true
    )
  fi
  printf '%s' "$secret"
}

update() (
  cp "$root/License" "$repo_dir/LICENSE"

  (
    cd "$from_dir" || exit
    cp \
      ReadMe.md \
      dub.json \
      "$repo_dir"
    mkdir -p "$repo_dir/source"
    cp source/*.d "$repo_dir/source/"
  )
)

after_release() (
  local secret
  secret=$(dub_secret)

  if [[ ${YS_RELEASE_DRYRUN-} || ${YS_RELEASE_DRY_RUN-} ]]; then
    echo 'X - curl -X POST https://code.dlang.org/api/packages/yamlscript/update'
    return
  fi

  [[ $secret ]] || {
    echo 'Error: DUB_UPDATE_SECRET or .dlang.token.yamlscript must be set' >&2
    exit 1
  }

  local response
  response=$(curl --fail-with-body -sS -X POST \
      https://code.dlang.org/api/packages/yamlscript/update \
      -H 'Content-Type: application/json' \
      -d "$(jq -cn --arg secret "$secret" '{secret: $secret}')")
  if [[ $response == *'Invalid secret'* ]]; then
    echo 'Error: code.dlang.org rejected DUB_UPDATE_SECRET' >&2
    return 1
  fi
  printf '%s\n' "$response"
)

main "$@"
