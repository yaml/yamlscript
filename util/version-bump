#!/usr/bin/env ys-0

ROOT =: ENV.ROOT ||
  die("'ROOT' env var not defined")

defn main():
  plan =: load("$ROOT/.version.ys")

  each p plan:
    vers bump move all =: p.slice(qw(vers bump move all))
    each b bump:
      regx file =: b.slice(qw(regx file))
      regx =: qr(regx)
      each f file:
        f =: "$ROOT/$f"
        text =: f:read
        m =: re-matcher(regx text)
        if re-find(m):
          do:
            x m1 m2 =: re-groups(m)
            replace =:
              if all:
                str/replace
                str/replace-first
            write f:
              replace:
                text regx
                str/re-quote-replacement("$m1$vers$m2")
            say: "Bumped '$f'"
          warn: +['No Match!!' f regx]

    each m move:
      from to =: m.slice(qw(from to))
      from =: "$ROOT/$from"
      to =: "$ROOT/$to"
      when fs-e(from):
        do:
          fs/mv: from to
          say: "Moved '$from' to '$to'"
