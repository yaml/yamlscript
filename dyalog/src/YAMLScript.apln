:Namespace YAMLScript

⎕IO←0
Version←'0.2.31'
BufferSize←1048576
Library←'./lib/yamlscript_dyalog.so'
'ys_load_json'⎕NA'I4 ',Library,'|ys_load_json <0UTF8 >0UTF8 I4'

∇ data←Load source;result;code;json;response
  result←ys_load_json(⊂source),BufferSize BufferSize
  code←⊃result
  json←1⊃result
  :If code<0
      ⎕SIGNAL 11
  :EndIf
  response←⎕JSON json
  :If 0≠response.⎕NC'error'
      :If ~(⊂'null')≡response.error
          ⎕SIGNAL 11
      :EndIf
  :EndIf
  data←response.data
∇

∇ data←LoadFile path;lines;source
  lines←⊃⎕NGET path 1
  source←∊lines,¨⊂⎕UCS 10
  data←Load source
∇

:EndNamespace
