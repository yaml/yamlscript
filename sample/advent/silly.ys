#!/usr/bin/env ys-0

use:
  ys::json: :as json
  ys::yaml: :as yaml

my-yaml =: |
  - Hello
  - Salutations
  - Ho Ho Ho
  - Merry Christmas
  - Happy Holidays
  - Seasons Greetings
  - Happy New Year
  - Happy Hanukkah
  - Happy Kwanzaa

my-json =: |
  [ "World",
    "Santa",
    "Elves",
    "Reindeer",
    "Snowman",
    "Mrs. Claus",
    "Rudolph",
    "Frosty",
    "Kids" ]

greets =: yaml/load(my-yaml)

names =: json/load(my-json)

say: "$rand-nth(greets), $rand-nth(names)!!"
