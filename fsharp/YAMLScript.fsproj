<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>YAMLScript</RootNamespace>
    <Version>0.2.29</Version>
    <PackageId>YAMLScript.FSharp</PackageId>
    <PackageVersion>0.2.29</PackageVersion>
    <Authors>YAMLScript Contributors</Authors>
    <Description>YAMLScript language binding for F#</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yaml/yamlscript</PackageProjectUrl>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/yaml/yamlscript</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/YAMLScript.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ReadMe.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
