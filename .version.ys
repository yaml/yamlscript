# Used by util/version-bump to update versions in repo

!ys-0

v-old =: ENV.YS_RELEASE_VERSION_OLD ||
  die("'YS_RELEASE_VERSION_OLD' env var not defined")
v-new =: ENV.YS_RELEASE_VERSION_NEW ||
  die("'YS_RELEASE_VERSION_NEW' env var not defined")

vp =: '0\.[12]\.[0-9]+'
vo =: v-old.str/replace(/\./ '\\.')


=>::
#------------------------------------------------------------------------------
# These files can change all occurences of old version to new version.
#------------------------------------------------------------------------------
- vers:: v-new
  all: true
  bump:
  - regx:: "()${vp}()"
    file:
    - Meta
    - ada/alire.toml
    - common/install.mk
    # Don't update common/vars.mk
    # - common/vars.mk
    - core/src/ys/v0.cljc
    - crystal/shard.yml
    - crystal/src/yamlscript/version.cr
    - crystal/src/yamlscript.cr
    - common-lisp/c_src/yamlscript_lisp.c
    - common-lisp/yamlscript.asd
    - csharp/YAMLScript.csproj
    - d/source/yamlscript.d
    - dart/lib/yamlscript.dart
    - delphi/src/yamlscript.pas
    - delphi/src/yamlscript_native.pas
    - dyalog/apl-package.json
    - dyalog/doc/readme.md
    - dyalog/ReadMe.md
    - dyalog/src/YAMLScript.apln
    - dyalog/src/yamlscript_dyalog.c
    - elixir/c_src/yamlscript_nif.c
    - elixir/doc/readme.md
    - elixir/ReadMe.md
    - erlang/c_src/yamlscript_nif.c
    - erlang/rebar.config
    - erlang/src/yamlscript.app.src
    - fortran/fpm.toml
    - fortran/src/yamlscript.f90
    - fortran/doc/readme.md
    - fortran/ReadMe.md
    - fsharp/YAMLScript.fsproj
    - kotlin/Makefile
    - kotlin/pom.xml
    - kotlin/src/main/kotlin/org/yamlscript/yamlscript/YS.kt
    - kotlin/doc/readme.md
    - kotlin/ReadMe.md
    - nim/src/yamlscript.nim
    - nim/yamlscript.nimble
    - r/DESCRIPTION
    - r/R/yamlscript.R
    - r/src/yamlscript.c
    - doc/install.md
    - doc/run-ys.md
    - doc/ys.md
    - doc/ys-v0.md
    - go/yamlscript.go
    - java/Makefile
    - java/src/main/java/org/yamlscript/yamlscript/YAMLScript.java
    - julia/src/libys.jl
    - nodejs/lib/yamlscript/index.js
    - perl-alien/alienfile
    - perl-alien/lib/Alien/YAMLScript.pm
    - perl/lib/YAMLScript.pm
    - powershell/YAMLScript.psd1
    - prolog/c_src/yamlscript_prolog.c
    - prolog/pack.pl
    - python/lib/yamlscript/__init__.py
    - raku/lib/YAMLScript.rakumod
    - ruby/lib/yamlscript.rb
    - ruby/lib/yamlscript/version.rb
    - rust/src/lib.rs
    - scala/pom.xml
    - scala/src/YAMLScript.scala
    - swift/Sources/YAMLScript/YAMLScript.swift
    - swift/doc/readme.md
    - swift/ReadMe.md
    - util/ysj
    - zig/src/yamlscript.zig
    - zig/doc/readme.md
    - zig/ReadMe.md
    - www/src/install
    - www/src/run-ys
    - www/src/cicd.md
    - ai/claude/ys-skill/skills/yamlscript/SKILL.md
    - ai/codex/.agents/skills/yamlscript/SKILL.md
    - blog/2023-12-07.md
    - ys/src/yamlscript/cli.clj
    - ys/test/cli-usage.t

#------------------------------------------------------------------------------
# These changes are very specific to not accidentally but something wrongly.
#------------------------------------------------------------------------------
- vers:: v-new
  bump:
  - regx:: "(yamlscript.*)${vp}(.*)"
    file:
    - clojure/deps.edn
    - clojure/project.clj
    - core/project.clj
    - libys/deps.edn
    - libys/project.clj
    - v0/project.clj
    - ys/deps.edn
    - ys/project.clj
    - ys/share/ys-0.bash

  - regx:: "(yamlscript\/core.*)${vp}(.*)"
    file:
    - libys/project.clj
    - ys/project.clj

  - regx:: "(YS.*)${vp}(.*)"
    file:
    - blog/2023-12-05.md
    - blog/2025-06-21.md

  - regx:: "(yamlscript\/yamlscript.*)${vp}(.*)"
    file:
    - clojure/project.clj

  - regx:: "(Alien::YAMLScript:.*)${vp}(.*)"
    file:
    - perl/Meta

  - regx:: "(version.*)${vp}(.*)"
    file:
    - dart/pubspec.yaml
    - elixir/mix.exs
    - nodejs/package.json
    - nodejs/package.yaml
    - java/pom.xml
    - julia/Project.toml
    - lua/lib/yamlscript.lua
    - moonbit/moon.mod
    - perl/Meta
    - perl-alien/Meta
    - php/composer.json
    - python/setup.py
    - raku/META6.json
    - rust/Cargo.toml
    - zig/build.zig.zon

  - regx:: "(VERSION.*)${vp}(.*)"
    file:
    - dyalog/Makefile
    - moonbit/pkg.generated.mbti
    - moonbit/yamlscript.c
    - moonbit/yamlscript.mbt

  - regx:: "(name = \"yamlscript\"\nversion = \")${vp}(\")"
    file:
    - rust/Cargo.lock

  - regx:: "(libys\\.)${vp}(\\.h)"
    file:
    - haskell/lib/YAMLScript/FFI.hs
